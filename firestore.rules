rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /orders/{orderId} {
      // Guest checkout writes go through /api/create-order (Admin SDK).
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/homepage {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/founder {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/admins {
      allow read, create, update, delete: if isAdmin();
    }

    match /admins/{adminDocId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminDocId);
      allow create, update, delete: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /paymentEvents/{eventId} {
      // Replay ledger for gateway callbacks/IPNs. Written only by the payment
      // handlers through the Admin SDK, which bypasses these rules.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
