# SHIS Fashion — environment template
# Copy to `.env.local` for local dev. Set the same keys in Vercel Production.
# Never commit real secrets.

# --- Required for production storefront + admin (Firebase client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Required for serverless order API (/api/create-order) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Production safety (COD launch) ---
VITE_SITE_URL=https://www.shisfashion.com
VITE_ALLOW_LOCAL_FALLBACK=false
VITE_LAUNCH_MODE=false
VITE_PREPAID_ENABLED=false
VITE_ADMIN_EMAILS=admin@yourdomain.com

# --- Cloudinary (admin media uploads) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_SIGNED_UPLOAD=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Analytics (recommended before paid traffic) ---
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_PROJECT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# --- Soft launch (optional) ---
VITE_SOFT_LAUNCH_MODE=off
SOFT_LAUNCH_MODE=off

# --- Prepaid Phase 2 only ---
# VITE_PREPAID_ENABLED=true
# BKASH_BASE_URL=

# --- Mobile wallet Send Money (Phase 2) ---
VITE_MOBILE_WALLET_PAYMENTS_ENABLED=true
VITE_BKASH_MERCHANT_NUMBER=01887848304
VITE_NAGAD_MERCHANT_NUMBER=01979614216
# --- Prepaid bKash API (Step 3 — server env, not VITE_) ---
# VITE_PREPAID_ENABLED=true
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://checkout.pay.bka.sh/v1.2.0-beta
PREPAID_CALLBACK_URL=https://www.shisfashion.com/api/prepaid-callback

# --- Ops alerts (Step 4 — optional Slack/Discord webhook) ---
INCIDENT_ALERT_WEBHOOK_URL=
