### Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

### Firebase Admin (Server-side)
# Required for Vercel API routes (/api/cloudinary-signature, /api/cloudinary-destroy)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

### Site
VITE_SITE_URL=https://shisfashion.com
VITE_GOOGLE_SITE_VERIFICATION=

### Safety
# Production should keep local fallback disabled so failed order writes never look successful.
VITE_ALLOW_LOCAL_FALLBACK=false

### Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=nzr2ptp6
VITE_CLOUDINARY_UPLOAD_PRESET=shis_fashion_upload

### Admin Access Configuration
# VITE_ADMIN_EMAILS: Comma-separated list of admin email addresses
VITE_ADMIN_EMAILS=shisfashion2@gmail.com

# VITE_LAUNCH_MODE: Temporary environment-based authentication for launch
# Set to 'true' to enable Launch Mode (bypasses Firebase Authentication)
# This is a temporary solution during development and should be disabled once Firebase is properly configured
VITE_LAUNCH_MODE=false

### Google Analytics / GA4
# VITE_GA_MEASUREMENT_ID: GA4 Measurement ID for page view tracking
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

### Meta Pixel (Facebook Pixel)
# VITE_META_PIXEL_ID: Meta Pixel ID for tracking conversions and user behavior
VITE_META_PIXEL_ID=1231414068906707

### Soft Launch Controls
# Modes: off | percentage | invite-only
VITE_SOFT_LAUNCH_MODE=off
# Used when mode=percentage
VITE_SOFT_LAUNCH_PERCENT=30
# Used when mode=invite-only (comma-separated codes)
VITE_SOFT_LAUNCH_INVITE_CODES=
# Keep false for local development unless you specifically test gating
VITE_SOFT_LAUNCH_ENFORCE_IN_DEV=false

### Soft Launch Controls (Server-side edge middleware)
# These are used by middleware.ts in production for stronger enforcement.
SOFT_LAUNCH_MODE=off
SOFT_LAUNCH_PERCENT=30
SOFT_LAUNCH_INVITE_CODES=

### Session Replay (Microsoft Clarity)
VITE_CLARITY_PROJECT_ID=

### Incident Alerting (Step 2)
# Enable client forwarding of critical incidents to server route.
VITE_ERROR_ALERTS_ENABLED=false
# Server-side webhook URL (Slack/Discord/etc.) used by /api/incident-alert.
INCIDENT_ALERT_WEBHOOK_URL=
