### Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

### Site
VITE_SITE_URL=https://shisfashion.com
VITE_GOOGLE_SITE_VERIFICATION=

### Safety
# Production should keep local fallback disabled so failed order writes never look successful.
VITE_ALLOW_LOCAL_FALLBACK=false

### Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=nzr2ptp6
VITE_CLOUDINARY_UPLOAD_PRESET=shis_fashion_upload

### Admin Access Configuration
# VITE_ADMIN_EMAILS: Comma-separated list of admin email addresses
VITE_ADMIN_EMAILS=shisfashion2@gmail.com

# VITE_LAUNCH_MODE: Temporary environment-based authentication for launch
# Set to 'true' to enable Launch Mode (bypasses Firebase Authentication)
# This is a temporary solution during development and should be disabled once Firebase is properly configured
VITE_LAUNCH_MODE=false

### Google Analytics / GA4
# VITE_GA_MEASUREMENT_ID: GA4 Measurement ID for page view tracking
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

### Meta Pixel (Facebook Pixel)
# VITE_META_PIXEL_ID: Meta Pixel ID for tracking conversions and user behavior
VITE_META_PIXEL_ID=1231414068906707
